# Required for booking submissions; not needed to build or browse pages.
# Server-only persistence. Never put privileged keys in NEXT_PUBLIC_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional feature: all three settings are needed for practice notifications.
# Missing settings or invalid addresses skip email without failing a stored booking.
# Use one bare email address for each email setting.
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL=

# Required before publishing; optional locally. Public website origin, not a Supabase URL.
# Unconfigured production uses a reserved placeholder. Rebuild after changing.
NEXT_PUBLIC_SITE_URL=
